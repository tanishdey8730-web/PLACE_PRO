generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MENTOR
  RECRUITER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CodingCategory {
  ARRAYS
  STRINGS
  LINKED_LIST
  STACK
  QUEUE
  TREES
  GRAPHS
  DYNAMIC_PROGRAMMING
  GREEDY
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
}

enum AptitudeCategory {
  QUANTITATIVE
  LOGICAL
  VERBAL
}

enum InterviewType {
  TECHNICAL
  HR
  BEHAVIORAL
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum ContestType {
  CODING
  APTITUDE
  COMPANY
}

enum PostType {
  DISCUSSION
  DOUBT
  CODING
  GENERAL
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum RoadmapSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoadmapCategory {
  DSA
  APTITUDE
  SYSTEM_DESIGN
  CORE_SUBJECTS
  PROJECTS
  RESUME_BUILDING
}

enum ResumeBuilderTemplate {
  ATS_FRIENDLY
  PROFESSIONAL
  MODERN
}

enum CoverLetterTemplate {
  PROFESSIONAL
  MODERN
  FORMAL
  CONCISE
}

enum CoverLetterDocType {
  COVER_LETTER
  INTERNSHIP_APPLICATION
  REFERRAL_REQUEST
  HR_FOLLOW_UP
}

enum ReferralListingType {
  REQUEST
  OFFER
}

enum ReferralListingStatus {
  OPEN
  MATCHED
  CLOSED
}

enum ReferralConnectionStatus {
  PENDING
  ACTIVE
  REFERRED
  COMPLETED
  DECLINED
  CANCELLED
}

enum PlacementTrackerStage {
  APPLIED
  OA_CLEARED
  INTERVIEW_SCHEDULED
  HR_ROUND
  SELECTED
  REJECTED
}

enum SalaryCompanyType {
  PRODUCT
  SERVICE
  STARTUP
  FAANG
  MNC
  CONSULTING
}

enum InterviewExperienceDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum CodingBattleStatus {
  WAITING
  MATCHMAKING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CodingBattleMode {
  ONE_VS_ONE
  MULTIPLAYER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatar        String?
  role          UserRole  @default(STUDENT)
  emailVerified DateTime?
  bio           String?
  college       String?
  graduationYear Int?
  skills        String[]  @default([])
  githubUrl     String?
  linkedinUrl   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  otpCodes          OtpCode[]
  profile           StudentProfile?
  submissions       Submission[]
  aptitudeAttempts  AptitudeAttempt[]
  resumes           Resume[]
  mockInterviews    MockInterview[]
  courseProgress    CourseProgress[]
  contestEntries    ContestEntry[]
  jobApplications   JobApplication[]
  mentorProfile     MentorProfile?
  mentorBookings    MentorBooking[]  @relation("StudentBookings")
  posts             Post[]
  comments          Comment[]
  upvotes           Upvote[]
  badges            UserBadge[]
  xpLogs            XpLog[]
  streak            Streak?
  notifications     Notification[]
  subscriptions     Subscription[]
  discussions       Discussion[]
  placementRoadmaps PlacementRoadmap[]
  companyPrepProgress CompanyPrepProgress[]
  resumeBuilderDocs   ResumeBuilderDocument[]
  linkedInAnalyses    LinkedInAnalysis[]
  coverLetters        CoverLetterDocument[]
  placementPredictions  PlacementProbabilityPrediction[]
  careerCoachSessions   CareerCoachSession[]
  jobMatchAnalyses      JobMatchAnalysis[]
  hrMockInterviews      HrMockInterview[]
  collabRoomsCreated    CollaborativeCodingRoom[]
  systemDesignSessions  SystemDesignSession[]
  projectReviews        ProjectReview[]
  gitHubProfileAnalyses GitHubProfileAnalysis[]
  dailyChallengeSets    DailyChallengeSet[]
  recruiterProfile      RecruiterProfile?
  jobsPosted            Job[]                 @relation("JobsPosted")
  recruiterInterviews   RecruiterInterview[]  @relation("RecruiterInterviews")
  candidateInterviews   RecruiterInterview[]  @relation("CandidateInterviews")
  referralListings      ReferralListing[]
  referralConnectionsInitiated ReferralConnection[] @relation("ReferralInitiator")
  referralConnectionsReceived  ReferralConnection[] @relation("ReferralParticipant")
  referralMessagesSent  ReferralMessage[]
  placementApplications PlacementApplication[]
  networkingSessions    NetworkingAssistantSession[]
  salaryPredictions     SalaryPrediction[]
  interviewExperiences  InterviewExperience[]
  interviewExperienceVotes InterviewExperienceVote[]
  interviewExperienceSaves InterviewExperienceSave[]
  interviewExperienceComments InterviewExperienceComment[]
  codingBattlesCreated  CodingBattle[]        @relation("BattleCreator")
  codingBattleParticipants CodingBattleParticipant[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  placementReadiness  Float    @default(0)
  codingScore         Float    @default(0)
  aptitudeScore       Float    @default(0)
  interviewScore      Float    @default(0)
  resumeAtsScore      Float    @default(0)
  totalXp             Int      @default(0)
  level               Int      @default(1)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt           DateTime @updatedAt
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodingProblem {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String         @db.Text
  difficulty  Difficulty
  category    CodingCategory
  companies   String[]       @default([])
  tags        String[]       @default([])
  starterCode Json
  timeLimit   Int            @default(2000)
  memoryLimit Int            @default(256000)
  acceptance  Float          @default(0)
  totalSubs   Int            @default(0)
  editorial   String?        @db.Text
  videoUrl    String?
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  testCases   TestCase[]
  submissions Submission[]
  discussions Discussion[]
  codingBattles CodingBattle[]
}

model TestCase {
  id        String        @id @default(cuid())
  problemId String
  input     String        @db.Text
  output    String        @db.Text
  isHidden  Boolean       @default(true)
  order     Int           @default(0)
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Submission {
  id           String           @id @default(cuid())
  userId       String
  problemId    String
  code         String           @db.Text
  language     Language
  status       SubmissionStatus @default(PENDING)
  runtime      Int?
  memory       Int?
  passedTests  Int              @default(0)
  totalTests   Int              @default(0)
  judgeToken   String?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      CodingProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
}

model Discussion {
  id        String        @id @default(cuid())
  problemId String
  userId    String
  content   String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AptitudeQuestion {
  id          String           @id @default(cuid())
  category    AptitudeCategory
  subCategory String
  question    String           @db.Text
  options     Json
  correctAnswer String
  explanation String?          @db.Text
  difficulty  Difficulty
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())

  attempts AptitudeAttempt[]
}

model AptitudeQuiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    AptitudeCategory
  duration    Int
  questionIds String[]
  isMockExam  Boolean  @default(false)
  createdAt   DateTime @default(now())

  attempts AptitudeAttempt[]
}

model AptitudeAttempt {
  id         String   @id @default(cuid())
  userId     String
  quizId     String?
  questionId String?
  answers    Json
  score      Float
  timeTaken  Int?
  completedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       AptitudeQuiz? @relation(fields: [quizId], references: [id])
  question   AptitudeQuestion? @relation(fields: [questionId], references: [id])
}

model Resume {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileUrl      String
  atsScore     Float?
  analysis     Json?
  suggestions  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MockInterview {
  id              String        @id @default(cuid())
  userId          String
  type            InterviewType
  questions       Json
  transcript      Json?
  recordingUrl    String?
  communication   Float?
  confidence      Float?
  technicalScore  Float?
  feedback        Json?
  duration        Int?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  category    String
  thumbnail   String?
  duration    Int
  level       Difficulty
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lessons  Lesson[]
  progress CourseProgress[]
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String?  @db.Text
  videoUrl  String?
  order     Int
  duration  Int      @default(0)
  quiz      Json?
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  completed   Int      @default(0)
  total       Int      @default(0)
  lastLessonId String?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Contest {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  type        ContestType
  startTime   DateTime
  endTime     DateTime
  problemIds  String[]    @default([])
  rewards     Json?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  entries ContestEntry[]
}

model ContestEntry {
  id        String   @id @default(cuid())
  contestId String
  userId    String
  score     Int      @default(0)
  rank      Int?
  joinedAt  DateTime @default(now())
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model Company {
  id       String  @id @default(cuid())
  name     String  @unique
  logo     String?
  website  String?
  industry String?
  jobs     Job[]
  recruiters RecruiterProfile[]
  referralListings ReferralListing[]
}

model Job {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  description String   @db.Text
  type        JobType
  location    String
  salaryMin   Int?
  salaryMax   Int?
  skills      String[] @default([])
  experience  String?
  isActive    Boolean  @default(true)
  postedById  String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])
  postedBy    User?    @relation("JobsPosted", fields: [postedById], references: [id], onDelete: SetNull)
  applications JobApplication[]
  recruiterInterviews RecruiterInterview[]
}

model JobApplication {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  status    ApplicationStatus @default(APPLIED)
  resumeUrl String?
  coverNote String?
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

model MentorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  expertise    String[]
  experience   Int
  hourlyRate   Float
  rating       Float    @default(0)
  totalSessions Int     @default(0)
  bio          String?  @db.Text
  availability Json?
  zoomLink     String?
  meetLink     String?
  isVerified   Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     MentorBooking[]
}

model MentorBooking {
  id        String   @id @default(cuid())
  mentorId  String
  studentId String
  scheduledAt DateTime
  duration  Int      @default(60)
  topic     String?
  status    String   @default("scheduled")
  meetUrl   String?
  mentor    MentorProfile @relation(fields: [mentorId], references: [id])
  student   User     @relation("StudentBookings", fields: [studentId], references: [id])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  type      PostType @default(GENERAL)
  tags      String[] @default([])
  upvoteCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  Comment[]
  upvotes   Upvote[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Upvote {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Badge {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xpRequired  Int    @default(0)

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model XpLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String           @id @default(cuid())
  userId    String
  plan      SubscriptionPlan @default(FREE)
  stripeId  String?
  razorpayId String?
  expiresAt DateTime?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerPlan {
  id        String   @id @default(cuid())
  userId    String
  path      String
  plan      Json
  createdAt DateTime @default(now())
}

model PlacementRoadmap {
  id               String            @id @default(cuid())
  userId           String
  branch           String
  graduationYear   Int
  skillLevel       RoadmapSkillLevel
  targetCompanies  String[]          @default([])
  studyHoursPerDay Int
  plan             Json
  progressPercent  Float             @default(0)
  adaptiveNotes    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedTasks   RoadmapTaskCompletion[]

  @@index([userId])
}

model RoadmapTaskCompletion {
  id          String           @id @default(cuid())
  roadmapId   String
  taskKey     String
  category    RoadmapCategory?
  completedAt DateTime         @default(now())
  roadmap     PlacementRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, taskKey])
  @@index([roadmapId])
}

model CompanyPrepProgress {
  id               String   @id @default(cuid())
  userId           String
  companySlug      String
  completedSections String[] @default([])
  readinessScore   Float    @default(0)
  progressPercent  Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companySlug])
  @@index([userId])
}

model ResumeBuilderDocument {
  id           String                @id @default(cuid())
  userId       String
  title        String                @default("My Resume")
  template     ResumeBuilderTemplate @default(ATS_FRIENDLY)
  content      Json
  atsScore     Float?
  qualityScore Float?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LinkedInAnalysis {
  id            String   @id @default(cuid())
  userId        String
  profileUrl    String
  linkedinScore Float
  analysis      Json
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CoverLetterDocument {
  id           String              @id @default(cuid())
  userId       String
  companyName  String
  jobTitle     String
  template     CoverLetterTemplate @default(PROFESSIONAL)
  documents    Json
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlacementProbabilityPrediction {
  id                    String   @id @default(cuid())
  userId                String
  cgpa                  Float
  dsaScore              Float
  aptitudeScore         Float
  resumeScore           Float
  projectCount          Int
  certificationCount    Int
  overallProbability    Float
  companyProbabilities  Json
  improvementSuggestions Json
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CareerCoachMessageRole {
  USER
  ASSISTANT
}

model CareerCoachSession {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("Career coaching")
  targetRole String   @default("Software Engineer")
  insights   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   CareerCoachMessage[]

  @@index([userId])
}

model CareerCoachMessage {
  id        String                 @id @default(cuid())
  sessionId String
  role      CareerCoachMessageRole
  content   String                 @db.Text
  metadata  Json?
  createdAt DateTime               @default(now())
  session   CareerCoachSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model JobMatchAnalysis {
  id              String   @id @default(cuid())
  userId          String
  jobTitle        String?
  companyName     String?
  resumeText      String   @db.Text
  jobDescription  String   @db.Text
  matchScore      Float
  missingSkills   String[] @default([])
  strengths       String[] @default([])
  weaknesses      String[] @default([])
  analysis        Json?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HrMockInterview {
  id              String    @id @default(cuid())
  userId          String
  targetRole      String    @default("Software Engineer")
  companyName     String?
  questions       Json
  answers         Json?
  communication   Float?
  confidence      Float?
  clarity         Float?
  professionalism Float?
  overallScore    Float?
  report          Json?
  duration        Int?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CollaborativeCodingRoom {
  id          String   @id @default(cuid())
  roomCode    String   @unique
  title       String   @default("Pair Programming Session")
  language    String   @default("python")
  code        String   @db.Text @default("")
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([roomCode])
  @@index([createdById])
}

model SystemDesignSession {
  id              String    @id @default(cuid())
  userId          String
  topicId         String
  topicTitle      String
  design          String    @db.Text
  scalability     Float?
  architecture    Float?
  databaseDesign  Float?
  caching         Float?
  security        Float?
  overallScore    Float?
  report          Json?
  duration        Int?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
}

model ProjectReview {
  id               String   @id @default(cuid())
  userId           String
  repoUrl          String
  repoFullName     String
  primaryLanguage  String?
  projectScore     Float
  codeQuality      Float?
  architecture     Float?
  documentation    Float?
  resumeWorthiness Float?
  report           Json?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([repoFullName])
}

model GitHubProfileAnalysis {
  id                   String   @id @default(cuid())
  userId               String
  username             String
  profileUrl           String
  publicRepos          Int      @default(0)
  followers            Int      @default(0)
  developerScore       Float
  repositories         Float?
  languages            Float?
  contributionActivity Float?
  projectQuality       Float?
  openSourceActivity   Float?
  report               Json?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
}

model DailyChallengeSet {
  id               String   @id @default(cuid())
  userId           String
  challengeDate    String
  placementGoal    String   @default("general")
  weakTopics       String[] @default([])
  progressSnapshot Json?
  challenges       Json
  answerKey        Json?
  completedCount   Int      @default(0)
  totalCount       Int
  isDayComplete    Boolean  @default(false)
  xpEarned         Int      @default(0)
  summary          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeDate])
  @@index([userId])
}

model RecruiterProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  companyId  String?
  jobTitle   String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model RecruiterInterview {
  id              String   @id @default(cuid())
  recruiterId     String
  candidateId     String
  jobId           String?
  scheduledAt     DateTime
  durationMinutes Int      @default(45)
  type            String   @default("technical")
  status          String   @default("scheduled")
  location        String?
  meetingUrl      String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  recruiter       User     @relation("RecruiterInterviews", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate       User     @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([recruiterId])
  @@index([candidateId])
  @@index([scheduledAt])
}

model ReferralListing {
  id           String                @id @default(cuid())
  userId       String
  type         ReferralListingType
  companyId    String?
  companyName  String
  targetRole   String
  description  String                @db.Text
  skills       String[]              @default([])
  status       ReferralListingStatus @default(OPEN)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  connections  ReferralConnection[]

  @@index([userId])
  @@index([type, status])
  @@index([companyId])
  @@index([companyName])
}

model ReferralConnection {
  id              String                   @id @default(cuid())
  listingId       String
  initiatorId     String
  participantId   String
  status          ReferralConnectionStatus @default(PENDING)
  trackingNotes   String?                  @db.Text
  referredAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  listing         ReferralListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  initiator       User                     @relation("ReferralInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  participant     User                     @relation("ReferralParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  messages        ReferralMessage[]

  @@unique([listingId, initiatorId, participantId])
  @@index([initiatorId])
  @@index([participantId])
  @@index([status])
}

model ReferralMessage {
  id           String             @id @default(cuid())
  connectionId String
  senderId     String
  body         String             @db.Text
  createdAt    DateTime           @default(now())
  connection   ReferralConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model PlacementApplication {
  id          String               @id @default(cuid())
  userId      String
  companyName String
  role        String
  location    String?
  jobType     String?
  stage       PlacementTrackerStage @default(APPLIED)
  appliedAt   DateTime             @default(now())
  nextEventAt DateTime?
  notes       String?              @db.Text
  salaryOffer String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, stage])
}

model NetworkingAssistantSession {
  id               String   @id @default(cuid())
  userId           String
  targetRole       String
  targetCompanies  String[] @default([])
  industry         String?
  summary          String   @db.Text
  result           Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model SalaryPrediction {
  id              String            @id @default(cuid())
  userId          String
  skills          String[]          @default([])
  experienceYears Float
  location        String
  companyType     SalaryCompanyType
  role            String?
  minLpa          Float
  maxLpa          Float
  medianLpa       Float
  result          Json
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model InterviewExperience {
  id             String                      @id @default(cuid())
  userId         String
  companyName    String
  role           String
  interviewDate  DateTime?
  questionsAsked String                      @db.Text
  difficulty     InterviewExperienceDifficulty @default(MEDIUM)
  tips           String?                     @db.Text
  tags           String[]                    @default([])
  upvoteCount    Int                         @default(0)
  downvoteCount  Int                         @default(0)
  shareCount     Int                         @default(0)
  status         ModerationStatus            @default(APPROVED)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       InterviewExperienceComment[]
  votes          InterviewExperienceVote[]
  saves          InterviewExperienceSave[]

  @@index([companyName])
  @@index([status, createdAt])
  @@index([userId])
}

model InterviewExperienceVote {
  id           String              @id @default(cuid())
  experienceId String
  userId       String
  vote         Int
  createdAt    DateTime            @default(now())
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
}

model InterviewExperienceSave {
  id           String              @id @default(cuid())
  experienceId String
  userId       String
  createdAt    DateTime            @default(now())
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
}

model InterviewExperienceComment {
  id           String              @id @default(cuid())
  experienceId String
  userId       String
  content      String              @db.Text
  createdAt    DateTime            @default(now())
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model CodingBattle {
  id              String               @id @default(cuid())
  roomCode        String               @unique
  creatorId       String
  mode            CodingBattleMode     @default(ONE_VS_ONE)
  status          CodingBattleStatus   @default(WAITING)
  problemId       String?
  durationSeconds Int                  @default(1800)
  maxPlayers      Int                  @default(2)
  startedAt       DateTime?
  endedAt         DateTime?
  winnerId        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  creator         User                 @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  problem         CodingProblem?       @relation(fields: [problemId], references: [id], onDelete: SetNull)
  participants    CodingBattleParticipant[]

  @@index([status])
  @@index([roomCode])
}

model CodingBattleParticipant {
  id        String       @id @default(cuid())
  battleId  String
  userId    String
  score     Int          @default(0)
  rank      Int?
  code      String?      @db.Text
  language  Language?
  joinedAt  DateTime     @default(now())
  battle    CodingBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
}
